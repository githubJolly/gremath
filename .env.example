# Copy to .env and fill in real values:
#   cp .env.example .env

# Public URL used in verification email links (your domain or localhost)
APP_BASE_URL=http://localhost

# Sender shown in verification emails
MAIL_FROM=noreply@yourdomain.com

# SMTP (required to actually send verification emails)
SPRING_MAIL_HOST=smtp.yourprovider.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your-smtp-username
SPRING_MAIL_PASSWORD=your-smtp-password
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
